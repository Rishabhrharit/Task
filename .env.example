# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/otc
# Or use split PostgreSQL settings:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=otc
# DB_USER=postgres
# DB_PASSWORD=your_password

# Shippo
SHIPPO_API_TOKEN=shippo_test_replace_me

# Generic REST connector
API_URL=https://api.example.com/v1/orders
API_TOKEN=replace-with-token
API_TOKEN_HEADER=Authorization
API_TOKEN_PREFIX=Bearer
SOURCE_SYSTEM=example_api
SOURCE_ENTITY=orders
API_ID_FIELD=id
API_RECORDS_PATH=

# Legacy local ERP-shaped API
ERP_API_URL=http://localhost:8000/orders

# Odoo
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USERNAME=admin@example.com
ODOO_PASSWORD=your_odoo_password_or_api_key
ODOO_LIMIT=100

# Canonical schema
CANONICAL_SCHEMA_PATH=C:\path\to\canonical.schema.json

# Neo4j
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=neo4j
